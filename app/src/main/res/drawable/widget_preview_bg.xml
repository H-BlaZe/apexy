<?xml version="1.0" encoding="utf-8"?>
<!-- Static stand-in shown in the launcher's widget picker; the live widget draws real soft shadows. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:inset="10dp">
    <shape android:shape="rectangle">
        <corners android:radius="26dp" />
        <solid android:color="@color/surface" />
    </shape>
</inset>
